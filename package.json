{
  "name": "redeliver",
  "version": "0.1.0",
  "description": "Self-hosted webhook relay: verify, queue, retry and replay webhooks",
  "type": "module",
  "private": true,
  "license": "MIT",
  "author": "Reza Ghaderi",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "start": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env src/server.js",
    "dev": "node --disable-warning=ExperimentalWarning --env-file-if-exists=.env --watch src/server.js",
    "test": "node --disable-warning=ExperimentalWarning --test \"test/**/*.test.js\"",
    "lint": "eslint ."
  },
  "dependencies": {
    "fastify": "^5.12.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "globals": "^17.14.0"
  }
}
